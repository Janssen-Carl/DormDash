APP_NAME=DormDash
APP_ENV=production
APP_KEY=base64:FEUb82xuXqNHnIFy9LBg1fozk74aoSf+25+kuIePxIw=
APP_DEBUG=true
APP_URL=http://127.0.0.1:80
AI_API_URL=http://ai:5000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (matches docker-compose service name "db")
DB_CONNECTION=mysql
DB_HOST=db
DB_DATABASE=dormdash_db_v4
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=pass


# Cache / Sessions
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false # remove this in prod
QUEUE_CONNECTION=sync


# Redis (only if you use it)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (dev setup)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
UID=1000
GID=1000
